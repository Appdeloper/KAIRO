<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only: the Worker URL must be https:// and nothing may downgrade it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
