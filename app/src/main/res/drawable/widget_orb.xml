<?xml version="1.0" encoding="utf-8"?>
<!-- Static orb for the widget: RemoteViews can't run shaders, so a gradient stands in. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">
    <path android:pathData="M32,2a30,30 0,1 1,0 60a30,30 0,1 1,0 -60z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="32"
                android:centerY="32"
                android:gradientRadius="30">
                <item android:offset="0" android:color="#3300F0FF" />
                <item android:offset="1" android:color="#0000F0FF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M32,14a18,18 0,1 1,0 36a18,18 0,1 1,0 -36z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="28"
                android:centerY="28"
                android:gradientRadius="22">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.4" android:color="#FF00F0FF" />
                <item android:offset="1" android:color="#FFFF2BD6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
